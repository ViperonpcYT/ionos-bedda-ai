STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_CURRENCY=cad
WEBHOOK_KEY=
STRIPE_WEBHOOK_SECRET=whsec_...

# Cron / admin API (comma-separated). Use ONE value for IONOS payment-reconcile cron URL ?key=
# Example: onlybikes-reconcile-a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6
VALID_API_KEYS=

# Optional: overrides email-admin/config.php password hash when set (bedda uses this in api/.env).
# Leave blank on OnlyBikes — config.php fallback hash is used instead.
# ADMIN_PASSWORD_HASH=

# Points cron (?key=). Generate: openssl rand -hex 32
CRON_SECRET=

SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
# Ionos mailbox that matches your domain (e.g. support@onlybikes.shop) + its password
SMTP_USERNAME=
SMTP_PASSWORD=

CHITCHATS_CLIENT_ID=YOUR_CHITCHATS_CLIENT_ID
CHITCHATS_ACCESS_TOKEN=YOUR_CHITCHATS_ACCESS_TOKEN_HERE
# Ship-from address — must match your ChitChats return-address profile
ONLYBIKES_WAREHOUSE_POSTAL=L5M3R5
ONLYBIKES_WAREHOUSE_CITY=Mississauga
ONLYBIKES_WAREHOUSE_PROVINCE=ON

# AI chat widget (llama-cli + GGUF on Ionos)
AI_BINARY_PATH=/homepages/6/d4299539843/htdocs/llama-b9285
AI_MODEL_PATH=/homepages/6/d4299539843/htdocs/models/qwen2.5-0.5b-instruct-q4_k_m.gguf
AI_MAX_TOKENS=180
AI_TIMEOUT_SEC=25
AI_CONTEXT_LEN=1024
AI_THREADS=1
AI_CACHE_TTL=86400
AI_RATE_LIMIT_PER_IP_PER_HOUR=60
AI_RATE_LIMIT_PER_IP_PER_MINUTE=8

# Bike Roast — enterprise cloud vision + local judge (see api/ROAST-DEPLOY.md)
# Set ROAST_EVENT_ENABLED=1 before promoting Solo roast / Live PvP (homepage banner + nav)
ROAST_EVENT_ENABLED=0
ROAST_EVENT_END=2026-07-01
ROAST_PIPELINE_MODE=cloud_first
ROAST_RATE_LIMIT_PER_IP_PER_DAY=1
ROAST_DAILY_MAX_JOBS=15
ROAST_MAX_CONCURRENT=1
ROAST_GROQ_API_KEY=
ROAST_OPENROUTER_API_KEY=
ROAST_VISION_MODEL=llama-3.2-11b-vision-preview
ROAST_VISION_MODEL_OR_LLAMA=meta-llama/llama-3.2-11b-vision-instruct
ROAST_VISION_MODEL_OR_QWEN=qwen/qwen-2.5-vl-3b-instruct
ROAST_VISION_MAX_TOKENS=300
ROAST_VISION_TEMPERATURE=0.1
ROAST_VISION_TIMEOUT_SEC=12
ROAST_JUDGE_GGUF=
ROAST_JUDGE_CTX=2048
ROAST_JUDGE_N_PREDICT=150
ROAST_JUDGE_TEMP=0.7
ROAST_JUDGE_LOCAL_TIMEOUT_SEC=15
ROAST_JUDGE_MODEL_GROQ=llama-3.1-8b-instant
ROAST_JUDGE_MODEL_OR=qwen/qwen-2.5-1.5b-instruct
ROAST_JUDGE_GROQ_TEMP=0.8
ROAST_JUDGE_GROQ_MAX_TOKENS=200
ROAST_JUDGE_CLOUD_TIMEOUT_SEC=12
ROAST_MODELS_DIR=
ROAST_THREADS=1
ROAST_TMP_DIR=
ROAST_SHAME_SCORE_ENABLED=1
ROAST_STEP_MIN_MS=1200
# Dev bypass for daily roast limits (solo + PvP orchestrator). Set on server only.
ROAST_BYPASS_KEY=OB-RoastDev-7k9mQ2
ROAST_PVP_ROUND_SEC=180
# WebRTC outbound caps — lower = less Metered TURN GB (see ROAST-PVP-UPLOAD.txt bandwidth table)
PVP_WEBRTC_MAX_VIDEO_KBPS=450
PVP_WEBRTC_MAX_AUDIO_KBPS=32
PVP_WEBRTC_MAX_WIDTH=640
PVP_WEBRTC_MAX_HEIGHT=480
PVP_WEBRTC_MAX_FPS=20
# WebRTC TURN — onlybikes.metered.live → PVP_TURN_APP=onlybikes
PVP_TURN_APP=onlybikes
# Developers tab Secret Key (recommended)
PVP_TURN_SECRET_KEY=
# OR TURN → Add Credential → Show API Key
PVP_TURN_API_KEY=
# Static TURN from Metered dashboard → Show ICE Servers Array (recommended on Ionos)
PVP_TURN_USERNAME=
PVP_TURN_CREDENTIAL=
PVP_TURN_URLS=stun:stun.relay.metered.ca:80,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
# Cloudflare Turnstile — Live PvP stuck verification (optional)
# Create at: Cloudflare Dashboard → Turnstile → Add widget → onlybikes.shop
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

ROAST_ADSENSE_CLIENT=ca-pub-6865501266103199
ROAST_ADSENSE_SLOT=
# Roast ad modals: AdSense → Monetag → Infolinks → house promos
ROAST_AD_WATERFALL=monetag,adsense,house
ROAST_MONETAG_ZONE_ID=11143884
ROAST_INFOLINKS_PID=3446030
ROAST_INFOLINKS_WSID=0
ROAST_AD_FILL_TIMEOUT_MS=4500

